    "dependencies": {
        "drizzle-orm": "^0.45.3",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "dotenv": "^18.0.6",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15"
